{
  "compilerOptions": {
    /* Core settings */
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    /* Folder structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Node compatibility */
    "esModuleInterop": true,
    "types": ["node"],

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,

    /* Quality of life */
    "sourceMap": true
  },

  "include": ["src"]
}